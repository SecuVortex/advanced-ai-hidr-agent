# HIDR Multi-Agent System - API Configuration
# Copy this file to .env and add your actual API keys

# VirusTotal API (Get from: https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Gemini API (Get from: https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional - Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Mistral API (Optional - Get from: https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# LLM Provider Selection (gemini, openai, or mistral)
LLM_PROVIDER=gemini

# System Configuration
REQUIRE_HUMAN_APPROVAL=true
LOG_LEVEL=INFO
MAX_THREAT_SCORE=10
QUARANTINE_ENABLED=true
