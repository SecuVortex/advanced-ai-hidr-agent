# HIDR Multi-Agent System - Environment Variables
# Copy this file to .env and add your API keys

# MalwareBazaar API Key (Free - Get from https://bazaar.abuse.ch/api/)
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key_here

# VirusTotal API Key (Optional - Get from https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
